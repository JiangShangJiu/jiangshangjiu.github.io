---
/**
 * 首页 = 成果展示页：定位 -> 成果展示 -> 关于与联系
 *
 * 首页刻意不列文章：文章由导航的「博客」进入。这里只展示 `projects`
 * 集合里的成果，每个成果用大卡片铺开——封面、关键指标（highlights）、
 * 量化结论与源码入口。
 *
 * 文案在 `src/config.ts` 的 `PROFILE` 里集中配置，改文案不用动这个文件。
 */
import { Icon } from 'astro-icon/components';

import { CONTACT_EMAIL, PROFILE, SITE } from '~/config';
import { withBase } from '~/i18n/utils';
import { blogIndexPath, getProjects, projectPath, projectsIndexPath } from '~/utils/projects';
import BaseLayout from '~/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}

const { locale } = Astro.props;

const projects = await getProjects();

const blogHref = blogIndexPath(locale);
const projectsHref = projectsIndexPath(locale);
---

<BaseLayout title={SITE.title} description={SITE.description} pathWithoutLocale="/">
  <!-- ============ 1. 定位 ============ -->
  <section class="profile-hero">
    <h1 class="profile-name">{PROFILE.name}</h1>
    <p class="profile-role">{PROFILE.role}</p>
    <p class="profile-lead">{PROFILE.lead}</p>

    {
      PROFILE.facts.length > 0 && (
        <ul class="fact-row">
          {PROFILE.facts.map((fact) => (
            <li>
              {fact.icon && <Icon name={fact.icon} width={14} height={14} />}
              {fact.text}
            </li>
          ))}
        </ul>
      )
    }

    {
      PROFILE.actions.length > 0 && (
        <div class="action-row">
          {PROFILE.actions.map((action) => {
            const isExternal = action.external === true;
            const href = isExternal ? action.url : withBase(action.url);
            return (
              <a
                class:list={['action-btn', action.primary && 'primary']}
                href={href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
              >
                {action.icon && <Icon name={action.icon} width={15} height={15} />}
                {action.label}
              </a>
            );
          })}
        </div>
      )
    }
  </section>

  <!-- ============ 2. 成果展示 ============ -->
  {
    projects.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>
            <Icon name="lucide:boxes" width={17} height={17} class="inline align-[-3px]" /> 成果展示
          </h2>
          <a href={projectsHref}>
            全部 {projects.length} 项{' '}
            <Icon name="lucide:chevron-right" width={13} height={13} class="inline align-[-2px]" />
          </a>
        </div>

        {projects.map((project) => {
          const {
            title,
            subtitle,
            description,
            heroImage,
            resultFigures,
            highlights,
            metrics,
            stack,
            buttons,
          } = project.data;
          const href = projectPath(project, locale);

          // 优先展示结果图（辨识/验证的结果），没有才退回封面。
          const figures = (
            resultFigures.length > 0
              ? resultFigures
              : heroImage
                ? [{ src: heroImage, alt: title, caption: undefined }]
                : []
          ).map((figure) => ({
            ...figure,
            src: withBase(figure.src),
          }));

          // 只有一个成果时铺满整宽；多个成果时两列排布，避免单个成果被拉得过宽。
          const solo = projects.length === 1;

          return (
            <article class:list={['project-feature', solo && 'is-solo']}>
              {figures.length > 0 && (
                <div class="feature-figures">
                  {figures.map((figure, index) => (
                    <figure class:list={['feature-result', index > 0 && 'is-secondary']}>
                      <img
                        src={figure.src}
                        alt={figure.alt ?? title}
                        loading="lazy"
                        decoding="async"
                      />
                      {figure.caption && <figcaption>{figure.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              )}

              <div class="feature-body">
                <h3 class="feature-title">
                  <a href={href}>{title}</a>
                </h3>

                {subtitle && <p class="feature-subtitle">{subtitle}</p>}
                {description && <p class="feature-desc">{description}</p>}

                {highlights.length > 0 && (
                  <div class="result-grid">
                    {highlights.map((item) => (
                      <div class="result-card">
                        <span class="result-value">{item.value}</span>
                        <span class="result-label">{item.label}</span>
                      </div>
                    ))}
                  </div>
                )}

                {(metrics.length > 0 || stack.length > 0) && (
                  <div class="feature-chips">
                    {metrics.map((metric) => (
                      <span class="chip is-strong">{metric}</span>
                    ))}
                    {stack.map((tech) => (
                      <span class="chip">{tech}</span>
                    ))}
                  </div>
                )}

                {buttons.length > 0 && (
                  <div class="action-row">
                    {buttons.map((btn) => (
                      <a
                        class:list={['action-btn', btn.primary && 'primary']}
                        href={btn.external ? btn.url : withBase(btn.url)}
                        target={btn.external ? '_blank' : undefined}
                        rel={btn.external ? 'noopener noreferrer' : undefined}
                      >
                        {btn.icon && <Icon name={btn.icon} width={15} height={15} />}
                        {btn.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </section>
    )
  }

  <!-- ============ 3. 关于与联系 ============ -->
  <section class="section">
    <div class="section-head">
      <h2>
        <Icon name="lucide:id-card" width={17} height={17} class="inline align-[-3px]" /> 关于我
      </h2>
      <a href={withBase('/about/')}>
        更多 <Icon name="lucide:chevron-right" width={13} height={13} class="inline align-[-2px]" />
      </a>
    </div>

    <p class="mb-2">
      我在机械臂动力学、参数辨识与运动控制方向持续投入，习惯把算法背后的数学推导、工程取舍与踩过的坑
      整理成长文，发布在<a href={blogHref}>博客</a>里。
    </p>
    <p class="text-base-content/70 mb-0 text-sm">
      欢迎通过
      <a href={`mailto:${CONTACT_EMAIL}`}>邮箱</a>
      或
      <a href={SITE.author.url} target="_blank" rel="noopener noreferrer">GitHub</a>
      与我交流。
    </p>
  </section>
</BaseLayout>

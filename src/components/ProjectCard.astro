---
/**
 * Project listing card with a linked video preview and a static-image fallback.
 */
import { Icon } from 'astro-icon/components';
import ProjectMedia from './ProjectMedia.astro';

import type { Locale } from '../config';
import { withBase } from '../i18n/utils';
import { projectPath, type Project } from '../utils/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { title, subtitle, description, heroImage, metrics, tags } = project.data;
const href = projectPath(project, locale);
const cover = typeof heroImage === 'string' ? withBase(heroImage) : undefined;
const hasVideo = Boolean(project.data.featureVideo || project.data.previewVideos?.length);
---

<article class="project-card">
  {
    hasVideo ? (
      <ProjectMedia project={project} locale={locale} />
    ) : (
      cover && (
        <a href={href} tabindex="-1" aria-hidden="true">
          <img class="project-cover" src={cover} alt={title} loading="lazy" decoding="async" />
        </a>
      )
    )
  }

  <div class="project-body">
    <h3 class="project-title">
      <a href={href}>{title}</a>
    </h3>

    {(description ?? subtitle) && <p class="project-desc">{description ?? subtitle}</p>}

    {
      metrics.length > 0 && (
        <div class="project-metrics">
          {metrics.map((metric) => (
            <span class="metric">{metric}</span>
          ))}
        </div>
      )
    }

    {hasVideo && (
      <a class="project-entry" href={href}
        >看演示与过程 <Icon name="lucide:arrow-up-right" width={14} height={14} /></a
      >
    )}

    {
      tags.length > 0 && (
        <div class="project-tags">
          {tags.map((tag) => (
            <span class="tag">
              <Icon name="lucide:hash" class="inline-block h-3 w-3 align-[-1px]" />
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .project-entry {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>

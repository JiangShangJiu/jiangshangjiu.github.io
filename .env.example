# ---------------------------------------------------------------------------
# 全部变量都是可选的。
#
# 站点身份（GitHub 账号、邮箱、Giscus 配置）已经写死在 `src/config.ts` 里，
# 本地开发不需要这个文件。
#
# 只有在你想用环境变量覆盖默认值、或者 CI 里要区分不同环境时才需要设置。
# 注意 `src/config.ts` 用的是 `||` 而不是 `??`，所以留空字符串等于"用默认值"，
# 不会把配置清空。
# ---------------------------------------------------------------------------

# 站点公网地址，结尾不要加斜杠。用于 canonical / OG / hreflang / sitemap。
SITE_URL=https://jiangshangjiu.github.io

# 站点部署在哪个子路径下。
#
# 本仓库是 `<owner>.github.io`，属于 GitHub 的**用户主页**，直接从域名根目录
# 提供服务，所以必须留空。（如果是 `owner/my-blog` 这种项目主页，才需要填
# `/my-blog`。）
BASE_PATH=

# --- 作者 / 社交链接 ---
# 填了之后 `src/config.ts` 会据此拼出 GitHub、邮箱等链接。
PUBLIC_GITHUB_HANDLE=JiangShangJiu
PUBLIC_CONTACT_EMAIL=laplacehurt@gmail.com

# --- Giscus 评论 ---
# 总开关。设为 "false" 可整体关闭评论。
PUBLIC_GISCUS_ENABLED=true
# 下面这些已经和仓库里的默认值一致，一般不用改。
# 换仓库或换讨论分类时，到 https://giscus.app 重新生成。
PUBLIC_GISCUS_REPO=JiangShangJiu/jiangshangjiu.github.io
PUBLIC_GISCUS_REPO_ID=R_kgDOLwslTw
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOLwslT84Ce5M9
